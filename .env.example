# ========================================
# HADER System - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Supabase Configuration ────────────────────────────
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# ── Local-Only Emergency Bootstrap (Disabled by default) ─────────
# Security note:
# - Never enable this in production builds.
# - Never use it while Supabase cloud mode is configured.
# - These values are bundled into the client when enabled.
VITE_ENABLE_BOOTSTRAP_ADMIN=false
VITE_BOOTSTRAP_ADMIN_USERNAME=""
VITE_BOOTSTRAP_ADMIN_PASSWORD=""
VITE_BOOTSTRAP_ADMIN_NAME="مدير النظام"

# ── Application Mode ─────────────────────────────────
# Options: hybrid (recommended), cloud, local
VITE_APP_MODE=hybrid
# Public HTTPS origin used by generated macOS/Windows launchers.
# Leave empty to use the current deployed origin. Set this in local/dev
# when you need downloaded desktop bundles to open production instead of localhost.
VITE_APP_URL=""
# Optional manifest for prebuilt native .dmg/.exe releases.
VITE_DESKTOP_RELEASE_URL=""
# Safety guard: keep false in production to avoid silent local-only mode
VITE_ALLOW_LOCAL_FALLBACK=false

# ── Feature Flags ─────────────────────────────────────
VITE_ENABLE_TELEMETRY=true
VITE_ENABLE_DEBUG=false
# Build-time opt-in. Keep disabled unless the PWA pipeline is intentionally enabled.
VITE_ENABLE_PWA=false

# ── Development Settings ─────────────────────────────
VITE_VERBOSE_LOGGING=false

# ── WhatsApp Integration (Optional) ──────────────────
# Server-side API key (NOT exposed to browser). Generate: openssl rand -hex 32
WHATSAPP_API_KEY="replace_with_a_generated_server_key"
# Browser reads the key from localStorage (set via Admin panel or console):
#   localStorage.setItem('hader:whatsapp_api_key', 'your_key')

# ── Telegram Bot (Optional) ──────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="replace_with_bot_token"

# Channel IDs (get from @userinfobot or web.telegram.org)
TELEGRAM_CHANNEL_MOBILE=""
TELEGRAM_CHANNEL_SUPERVISOR=""
TELEGRAM_CHANNEL_KIOSK=""
TELEGRAM_CHANNEL_EXITS=""
TELEGRAM_CHANNEL_ABSENCES=""
TELEGRAM_CHANNEL_LATE=""

# Admin Telegram user IDs (comma-separated)
TELEGRAM_ADMIN_IDS=""
