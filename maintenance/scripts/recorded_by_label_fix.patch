+// =============================================================================
+// resolveRecorder - Helper to safely resolve recorder info without sending strings to UUID column
+// =============================================================================
+/**
+ * Resolves recorder information for attendance_logs entries.
+ * Uses supabase.auth.getUser() to check for authenticated user.
+ *
+ * @param fallbackLabel - Label to use when no authenticated user (e.g., "kiosk", "admin-manual")
+ * @returns RecorderInfo with either UUID (if auth user) or label (if no auth user)
+ *
+ * @example
+ * // In bulkMarkAllPresent:
+ * const recorder = await resolveRecorder('admin-bulk');
+ * // Returns: { recorded_by: 'uuid-here', recorded_by_label: null } if authenticated
+ * // Returns: { recorded_by: null, recorded_by_label: 'admin-bulk' } if not authenticated
+ */
+export async function resolveRecorder(fallbackLabel: string = 'system'): Promise<RecorderInfo> {
+  try {
+    const { data: { user }, error } = await supabase.auth.getUser();
+
+    if (error || !user) {
+      // No authenticated user - use fallback label
+      return {
+        recorded_by: null,
+        recorded_by_label: fallbackLabel
+      };
+    }
+
+    // Authenticated user found - use their UUID
+    return {
+      recorded_by: user.id,
+      recorded_by_label: null
+    };
+  } catch (e) {
+    console.warn('[resolveRecorder] Error getting user, using fallback:', e);
+    return {
+      recorded_by: null,
+      recorded_by_label: fallbackLabel
+    };
+  }
+}
