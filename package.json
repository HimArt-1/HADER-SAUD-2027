{
  "name": "hader-system",
  "private": true,
  "version": "1.0.0",
  "description": "نظام حاضر - نظام متكامل لإدارة حضور الطلاب",
  "homepage": "https://hader-saud-2027.vercel.app",
  "author": "Hader Team",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "bundle:whatsapp": "node scripts/bundle-whatsapp-launcher.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run bundle:whatsapp && npm run typecheck && cross-env VITE_ENABLE_PWA=false vite build",
    "build:pwa": "npm run bundle:whatsapp && npm run typecheck && cross-env VITE_ENABLE_PWA=true vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "cross-env ELECTRON=true npm run build && electron-builder",
    "electron:build:mac": "npm run electron:icons && cross-env ELECTRON=true npm run build && electron-builder --mac",
    "electron:build:win": "npm run electron:icons && cross-env ELECTRON=true npm run build && electron-builder --win",
    "electron:build:linux": "npm run electron:icons && cross-env ELECTRON=true npm run build && electron-builder --linux",
    "electron:build:all": "cross-env ELECTRON=true npm run build && electron-builder --mac --win --linux",
    "electron:icons": "node scripts/generate-icons.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "crypto-js": "^4.2.0",
    "dexie": "^4.3.0",
    "framer-motion": "^12.29.2",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.11.6",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.12.0",
    "sql.js": "^1.10.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^14.2.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.58.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "sa.hader.app",
    "productName": "نظام حاضر",
    "copyright": "Copyright © 2024 Hader Team",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "artifactName": "Hader-${version}-mac-universal.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "dmg": {
      "title": "نظام حاضر",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 400
      }
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Hader-${version}-windows-x64-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Hader Team"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام حاضر"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "Hader Team"
    }
  }
}
